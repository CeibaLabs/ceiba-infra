# Terraform
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/*.tfstate
terraform/*.tfstate.*
# Broad on purpose: any *.tfvars file, not just terraform.tfvars, since a
# variable file is where real values live. *.tfvars.example does not match
# this pattern and stays tracked.
terraform/*.tfvars
terraform/*.tfplan
terraform/crash.log
terraform/crash.*.log
terraform/lambda-auto-shutdown/handler.zip

# Deploy — the filled-in env file holds every application credential
deploy/.env
deploy/.env.*
!deploy/.env.example

# Credentials and key material must never appear in this repo, under any name
*.pem
*.key
*.p12
*.pfx
.aws/
credentials

# OS
.DS_Store

# Operator documentation — deliberately private, maintained in the private
# _workspace repo under _workspace/infra/. These describe the live deployment
# procedure, the billing-guardrail response, and internal validation results.
# Ignored here so they cannot be re-added to a public repository by accident.
docs/rollout-runbook.md
docs/operator-deployment-guide.md
docs/billing-guardrail-runbook.md
docs/validation/