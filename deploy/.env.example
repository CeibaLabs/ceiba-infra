# Copy to deploy/.env (gitignored) and fill in real values. Never commit
# deploy/.env - only this .example file is tracked.
#
# This one file is read by BOTH control-plane and runtime (docker-compose.yml's
# env_file: .env on each service) - every variable below is visible to both
# containers. Where a variable name only makes sense for one app, that's
# noted; do not assume a name is namespaced to the service you're thinking of.
#
# Caddy is the exception: it deliberately does NOT get env_file, only the
# three CEIBA_*_HOST/ACME variables its Caddyfile actually references, so the
# one internet-facing process in the stack never holds application
# credentials. See the comment on the caddy service in docker-compose.yml.

# --- Stack / Caddy -----------------------------------------------------

# ECR repository URLs (terraform output ecr_runtime_repository_url /
# ecr_control_plane_repository_url) plus the immutable tag being deployed.
CONTROL_PLANE_IMAGE=<account-id>.dkr.ecr.<region>.amazonaws.com/ceiba-control-plane:<tag>
RUNTIME_IMAGE=<account-id>.dkr.ecr.<region>.amazonaws.com/ceiba-runtime:<tag>

# Caddyfile site addresses (see deploy/Caddyfile). Production: real
# hostnames, automatic HTTPS. Local verification: http://-prefixed
# *.localhost addresses, which keeps Caddy on plain HTTP.
CEIBA_APP_HOST=app.useceiba.com
CEIBA_API_HOST=api.useceiba.com
CEIBA_ACME_EMAIL=you@example.com

# --- Shared by both apps -------------------------------------------------

# Same Postgres for both (migrations apply from ceiba-runtime only).
DATABASE_URL=

# PORT is deliberately NOT set here, and should stay that way. Both images
# already default correctly on their own - ceiba-runtime's env schema
# defaults PORT to 8080 (src/config/env.ts), and ceiba-control-plane's
# Next.js standalone server.js defaults to 3000 when PORT is unset - and
# both Dockerfiles' HEALTHCHECK and EXPOSE already hardcode those same
# numbers. Because this one .env file is shared by both services, setting
# PORT to any single value here would apply to both containers identically
# and break whichever one didn't want that value. Leave it unset.
# PORT=

# --- ceiba-runtime only ---------------------------------------------------

# Self-hosted Redis, reachable only on the compose network (docker-compose.yml).
REDIS_URL=redis://redis:6379
LOG_LEVEL=info

# --- ceiba-control-plane only (mirrors ceiba-control-plane/.env.example exactly) ---

# Clerk auth (required for protected Control Plane routes).
# Get real values from the Clerk Dashboard API keys page.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk app routes. Keep these aligned with src/app/login and src/app/sign-up.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Stripe Checkout. With both set, /subscriptions can open hosted Checkout.
#
# CEIBA_PUBLIC_APP_URL must be this deployment's own public origin, full
# scheme, no trailing slash. It is NOT cosmetic and NOT only used by email:
# it becomes the success_url and cancel_url of every Stripe Checkout session
# (checkout/[planCode]/page.tsx, subscriptions/actions.ts) and the link
# target in the welcome and project-lifecycle emails. Left at a localhost
# value in production, a customer who completes payment is redirected to a
# dead address on their own machine - the charge succeeds and they land
# nowhere. This example carries the production value deliberately, because
# the previous localhost default is exactly the trap that got shipped once.
STRIPE_SECRET_KEY=
CEIBA_PUBLIC_APP_URL=https://app.useceiba.com

# Stripe webhooks. Real Dashboard signing secret; verifies POST /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=

# Clerk webhooks. Real Clerk Dashboard signing secret; verifies POST
# /api/webhooks/clerk on user.created (welcome email + Free provisioning).
CLERK_WEBHOOK_SIGNING_SECRET=

# Subscription confirmation email after successful Checkout (optional).
# If missing, webhook subscription sync still succeeds and email is skipped.
RESEND_API_KEY=
CEIBA_RECEIPT_FROM_EMAIL=
CEIBA_RECEIPT_REPLY_TO=

# --- Secrets Manager mapping ---------------------------------------------
#
# Real values for the credential-shaped variables above come from the
# Secrets Manager placeholders terraform/iam.tf already creates
# (aws_secretsmanager_secret.app, output as app_secret_arns) - populate
# those out-of-band (aws secretsmanager put-secret-value), then copy the
# resulting values into this file on the host, never into git:
#   STRIPE_SECRET_KEY             <- ceiba/stripe-secret-key
#   STRIPE_WEBHOOK_SECRET         <- ceiba/stripe-webhook-secret
#   CLERK_SECRET_KEY              <- ceiba/clerk-secret-key
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY <- ceiba/clerk-publishable-key
#   RESEND_API_KEY                <- ceiba/resend-api-key
# CLERK_WEBHOOK_SIGNING_SECRET and DATABASE_URL are not yet in
# terraform/iam.tf's secret list - see rollout-runbook.md steps 13/16.
